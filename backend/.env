DJANGO_ENV=dev
DJANGO_SECRET_KEY=dev-only-insecure-secret-key-replace-in-production-sams-2026
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SQLITE_DB_PATH=db.sqlite3
