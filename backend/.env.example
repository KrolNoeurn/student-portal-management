# Django Core
DJANGO_ENV=dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Default: SQLite WAL mode)
SQLITE_DB_PATH=db.sqlite3

# Optional PostgreSQL (When DJANGO_ENV=prod and POSTGRES_DB is set, prod.py uses PostgreSQL)
# POSTGRES_DB=sams_prod
# POSTGRES_USER=sams_app
# POSTGRES_PASSWORD=change-me-strong-password
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

# CORS, CSRF & HTTPS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DJANGO_SECURE_SSL_REDIRECT=True

# Localization & Timezone
TIME_ZONE=Asia/Phnom_Penh
DEFAULT_LANGUAGE=en

# File Uploads & Backups
MAX_UPLOAD_SIZE_MB=5
BACKUP_DIR=backups
